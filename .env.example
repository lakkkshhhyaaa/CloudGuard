
# ==========================================
# CLOUDGUARD - ENVIRONMENT CONFIGURATION
# ==========================================

# Application
APP_NAME=CloudGuard
APP_ENV=development

# PostgreSQL Database
POSTGRES_DB=cloudguard
POSTGRES_USER=cloudguard_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Keycloak IAM
KEYCLOAK_ADMIN_USERNAME=cloudguard_admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_PASSWORD

# Backend API
API_PORT=8000

# Frontend
FRONTEND_PORT=5173
